# PostgreSQL
PG_HOST=localhost
PG_USER=my_siblings_app
PG_PASSWORD=change_me_to_a_strong_password
PG_DATABASE=my_siblings

# Stripe — replace with your real keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# App Store links
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/mytruesiblings/id0000000000
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.mysiblings.app

# Trust proxy (set to "true" when behind Vercel, Cloudflare, nginx, etc.)
# When true, rate limiting uses X-Forwarded-For for client IP.
# When false/absent, uses X-Real-IP instead (harder to spoof).
TRUST_PROXY=false
